{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug blockchain_query",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/blockchain_query",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "INFURA_API_KEY",
                    "value": "${env:INFURA_API_KEY}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build with debug symbols",
            "miDebuggerPath": "/usr/bin/gdb",
            "sourceMap": {}
        }
    ]
}